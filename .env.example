# Encrypts saved connection passwords at rest (AES-256-GCM).
# Required in any shared or production environment.
# If unset, mydbtool uses an insecure development default and prints a warning.
CONNECTIONS_SECRET=change-me-to-a-long-random-string

# Optional path for the local connection store. Defaults to ./data/connections.json
# in browser / `npm run dev` mode. The Electron desktop app ignores this unless you
# export CONNECTIONS_PATH before launch; it stores connections under userData instead.
# CONNECTIONS_PATH=./data/connections.json
